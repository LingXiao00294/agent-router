[server]
host = "127.0.0.1"
port = 9456
log_level = "info"
log_file = "logs/agent-router.log"
log_max_bytes = 10000000
log_backup_count = 5

[router]
failure_threshold = 5
recovery_timeout = 600
mode = "sticky"   # 默认指定模型；改为 "failover" 可开启故障转移

[providers.zai]
type = "anthropic"
api_key = "${ZAI_API_KEY}"
base_url = "https://api.z.ai/api/anthropic"
timeout_seconds = 120
# 本地限流（0 = 不限制，保持旧行为）
# max_concurrent = 0
# max_queue = 0
# queue_wait_timeout = 30
# rate_limit_cooldown = 30

[providers.deepseek]
type = "anthropic"
api_key = "${DEEPSEEK_API_KEY}"
base_url = "https://api.deepseek.com/anthropic"
timeout_seconds = 120

[providers."mimo token plan"]
type = "anthropic"
api_key = "${MIMO_API_KEY}"
base_url = "https://token-plan-cn.xiaomimimo.com/anthropic"
timeout_seconds = 120

[models.opus-router]
pinned_provider = "mimo token plan"
pinned_model = "mimo-v2.5-pro"

[[models.opus-router.providers]]
provider = "mimo token plan"
model = "mimo-v2.5-pro"
priority = 1
# 可选，单位 USD / 1M Token；省略时快照为 NULL，显式 0 时快照保留 0
# 两种情况在费用计算时都按 0，但历史记录可区分
# input_price_per_million = 0
# output_price_per_million = 0
# cache_read_price_per_million = 0
# cache_write_price_per_million = 0

[[models.opus-router.providers]]
provider = "deepseek"
model = "deepseek-v4-pro"
priority = 2

[[models.opus-router.providers]]
provider = "zai"
model = "glm-5.2"
priority = 3

[models.sonnet-router]
pinned_provider = "deepseek"
pinned_model = "deepseek-v4-flash"

[[models.sonnet-router.providers]]
provider = "deepseek"
model = "deepseek-v4-flash"
priority = 1

[[models.sonnet-router.providers]]
provider = "mimo token plan"
model = "mimo-v2.5"
priority = 2

[models.haiku-router]
pinned_provider = "deepseek"
pinned_model = "deepseek-v4-flash"

[[models.haiku-router.providers]]
provider = "deepseek"
model = "deepseek-v4-flash"
priority = 1

[[models.haiku-router.providers]]
provider = "mimo token plan"
model = "mimo-v2.5"
priority = 2
