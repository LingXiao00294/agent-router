[server]
host = "127.0.0.1"
port = 9456
log_level = "info"
log_file = "logs/agent-router.log"
log_max_bytes = 10000000
log_backup_count = 5

[router]
failure_threshold = 5
recovery_timeout = 600

[providers.zai]
type = "anthropic"
api_key = "${ZAI_API_KEY}"
base_url = "https://api.z.ai/api/anthropic"
timeout_seconds = 120

[providers.deepseek]
type = "anthropic"
api_key = "${DEEPSEEK_API_KEY}"
base_url = "https://api.deepseek.com/anthropic"
timeout_seconds = 120

[providers."mimo token plan"]
type = "anthropic"
api_key = "${MIMO_API_KEY}"
base_url = "https://token-plan-cn.xiaomimimo.com/anthropic"
timeout_seconds = 120

[[models.opus-router]]
provider = "mimo token plan"
model = "mimo-v2.5-pro"
priority = 1

[[models.opus-router]]
provider = "deepseek"
model = "deepseek-v4-pro"
priority = 2

[[models.opus-router]]
provider = "zai"
model = "glm-5.2"
priority = 3

[[models.sonnet-router]]
provider = "deepseek"
model = "deepseek-v4-flash"
priority = 1

[[models.sonnet-router]]
provider = "mimo-token-plan"
model = "mimo-v2.5"
priority = 2

[[models.haiku-router]]
provider = "deepseek"
model = "deepseek-v4-flash"
priority = 1

[[models.haiku-router]]
provider = "mimo token plan"
model = "mimo-v2.5"
priority = 2

